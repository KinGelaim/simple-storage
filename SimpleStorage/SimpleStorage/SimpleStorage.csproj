  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleStorage.Generators\SimpleStorage.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

